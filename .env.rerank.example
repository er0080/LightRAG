# LightRAG Rerank Configuration Examples
# Copy the relevant section to your .env file

# ===========================================
# QWEN3 RERANKER CONFIGURATION (via vLLM API)
# ===========================================
# Use Qwen3 reranker through vLLM's OpenAI-compatible API
RERANK_PROVIDER=qwen3
RERANK_BINDING_HOST=http://localhost:8000/rerank
RERANK_BINDING_API_KEY=your-api-key-if-needed
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
QWEN3_RERANK_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# ===========================================
# JINA RERANKER CONFIGURATION
# ===========================================
# Use Jina AI reranker service
# RERANK_PROVIDER=jina
# RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
# RERANK_BINDING_API_KEY=your-jina-api-key
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===========================================
# COHERE RERANKER CONFIGURATION
# ===========================================
# Use Cohere reranker service
# RERANK_PROVIDER=cohere
# RERANK_BINDING_HOST=https://api.cohere.ai/v1/rerank
# RERANK_BINDING_API_KEY=your-cohere-api-key
# RERANK_MODEL=rerank-english-v2.0

# ===========================================
# CUSTOM RERANKER CONFIGURATION
# ===========================================
# Use custom/generic reranker API (backward compatibility)
# RERANK_PROVIDER=custom
# RERANK_BINDING_HOST=http://your-custom-api:8000/v1/rerank
# RERANK_BINDING_API_KEY=your-custom-api-key
# RERANK_MODEL=your-custom-model

# ===========================================
# COMMON RERANK SETTINGS
# ===========================================
# Minimum rerank score threshold
MIN_RERANK_SCORE=0.0

# Additional query settings that affect reranking
TOP_K=20
CHUNK_TOP_K=6
RELATED_CHUNK_NUMBER=10
